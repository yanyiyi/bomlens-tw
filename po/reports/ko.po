# Human-facing report strings for BomLens (conformance, AI profile, risk).
# Generated from docker/lib/i18n/report-strings.*.json + the English literals
# inlined in docker/lib/*.sh.
#
# After a Weblate push, regenerate the JSON the report generators read:
#   scripts/po-to-report-strings.sh ko
#
# Korean (ko) strings for the human-facing conformance and AI-profile reports.
# Loaded by validate-sbom.sh and generate-ai-profile.sh only when REPORT_LANG
# =ko; the English default reads nothing here and stays byte-identical.
# The machine-readable _conformance.json / _ai-profile.json stay English regardless.
# Do NOT translate data/identifiers: status codes and emoji (pass/warn/fail/review
# , PASS/FAIL/WARN/REVIEW), openness values, G7 element ids, PURLs, licenses
# , CycloneDX field paths, URLs, framework/article identifiers.
# Chrome keys use %s placeholders (shell printf).
# label/detail template keys use named tokens (%n% %a% %b% %v%) filled by jq.
msgid ""
msgstr ""
"Project-Id-Version: BomLens report-strings\n"
"Report-Msgid-Bugs-To: https://github.com/sktelecom/bomlens/issues\n"
"PO-Revision-Date: 2026-09-08 00:00+0800\n"
"Last-Translator: Automatically extracted <noreply@invalid>\n"
"Language-Team: ko\n"
"Language: ko\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"

