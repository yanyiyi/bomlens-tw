#, no-wrap
msgid "Prerequisites"
msgstr "必要條件"

#. type: Bullet: '- '
#: CONTRIBUTING.md:42
msgid "Docker 20.10+"
msgstr "Docker 20.10 以上"

#. type: Bullet: '- '
