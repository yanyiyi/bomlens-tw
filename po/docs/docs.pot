"MyApp_1.0.0_bom.json            # SBOM (CycloneDX 1.6)\n"
"MyApp_1.0.0_NOTICE.txt          # notice (text)\n"
"MyApp_1.0.0_NOTICE.html         # notice (HTML)\n"
