#. type: Plain text
#: docs/guides/reports.md:104
#, markdown-text
msgid ""
"Scans the generated SBOM with Trivy and reports known vulnerabilities "
"(CVEs). (NVD + OSV + GHSA DB)"
msgstr ""

#. type: Fenced code block (bash)
#: docs/guides/reports.md:105
#, no-wrap
msgid ""
"./scripts/scan-sbom.sh --project \"MyApp\" --version \"1.0.0\" --security "
