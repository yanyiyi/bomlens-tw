#, no-wrap
msgid "./scripts/scan-sbom.sh --project \"PythonExample\" --version \"1.0.0\" --target examples/python --generate-only\n"
msgstr "./scripts/scan-sbom.sh --project \"PythonExample\" --version \"1.0.0\" --target examples/python --generate-only\n"

#. type: Plain text
#: docs/reference/ecosystems.md:97
msgid "Detected file: `requirements.txt`, or `pyproject.toml` + `poetry.lock`"
msgstr ""
