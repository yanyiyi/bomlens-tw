"VERBOSE=true ./tests/test-scan.sh\n"
"\n"
"# Debug mode (for troubleshooting)\n"
"DEBUG_MODE=true ./tests/test-scan.sh\n"
"\n"
"# Save logs to a file\n"
"LOG_FILE=\"./test-results.log\" ./tests/test-scan.sh\n"
msgstr ""
"# Verbose 模式\n"
"VERBOSE=true ./tests/test-scan.sh\n"
"\n"
"# Debug 模式（用於分析問題）\n"
"DEBUG_MODE=true ./tests/test-scan.sh\n"
"\n"
"# 把日誌存成檔案\n"
