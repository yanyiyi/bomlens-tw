"\n"
"# Ubuntu-based image\n"
"./scripts/scan-sbom.sh \\\n"
"  --project \"UbuntuSBOM\" \\\n"
"  --version \"22.04\" \\\n"
"  --target \"ubuntu:22.04\" \\\n"
"  --generate-only\n"
