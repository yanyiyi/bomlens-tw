          "label_zh": "模型授權條款 — 開放程度（權重／架構／資料／訓練）",
          "role": "model-producer",
          "source": "inferred",
          "cdxPath": "(([ $subjects[] | (.properties // [])[]? | select((.name // \"\") | startswith(\"openness:\")) ] | length) > 0) or (([ .. | strings | select(test(\"open[ _-]?(weight|architecture|data|training)\";\"i\")) ] | length) > 0)",
          "evidencePath": "([ $subjects[] | (.properties // [])[]? | select((.name // \"\") | startswith(\"openness:\")) | \"\\(.name)=\\(.value)\" ] + [ .. | strings | select(test(\"open[ _-]?(weight|architecture|data|training)\";\"i\")) ]) | unique"
        },
